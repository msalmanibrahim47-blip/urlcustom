# Supabase project settings — Project Settings > API in the Supabase dashboard.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it into
# any file that ships to the browser. Used only in server actions / route
# handlers for privileged operations (e.g. analytics writes bypassing RLS
# read restrictions is NOT what this is for — it's kept for future admin
# operations that must bypass RLS, such as scripted project imports).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment, used to build public project links
# (https://yourdomain.com/p/slug) shown in the dashboard. Set this to your
# Netlify URL or your connected custom domain.
NEXT_PUBLIC_SITE_URL=https://your-platform.netlify.app
